{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": { "source": { "organizeImports": "on", "useSortedKeys": "on" } },
    "includes": ["**/*.ts", "**/*.js"]
  },
  "files": { "includes": ["**", "!test/fixtures"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "domains": { "types": "recommended" },
    "enabled": true,
    "rules": {
      "complexity": { "useLiteralKeys": "off" },
      "correctness": { "noUndeclaredDependencies": "error" },
      "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" },
      "performance": { "useTopLevelRegex": "error" },
      "preset": "recommended",
      "style": { "useImportType": "error", "useNodejsImportProtocol": "error" },
      "suspicious": { "noConsole": { "level": "error", "options": { "allow": ["error", "warn"] } } }
    }
  },
  "overrides": [
    {
      "formatter": { "enabled": false },
      "includes": ["CHANGELOG.md"]
    },
    {
      "includes": ["test/**"],
      "linter": { "rules": { "performance": { "useTopLevelRegex": "off" } } }
    }
  ],
  "vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true }
}
